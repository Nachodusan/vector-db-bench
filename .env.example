# Any OpenAI-compatible embeddings endpoint. Defaults target DeepInfra.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.deepinfra.com/v1/openai
BENCH_EMBED_MODEL=BAAI/bge-m3

# Engines
BENCH_QDRANT_URL=http://localhost:6333
BENCH_PG_DSN=postgresql:///postgres
BENCH_PG_MAINTENANCE_WORK_MEM=2GB
BENCH_PG_PARALLEL_WORKERS=4
